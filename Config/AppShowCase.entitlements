<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Geen sandbox: CoreMediaIO-schermcapture en het starten van adb vereisen dit. Distributie buiten de App Store. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<!-- Hardened runtime: iPhone-scherm komt binnen als (camera)capture-device. -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<!-- Het iPhone-schermdevice is "muxed" (beeld + geluid); macOS kan daarom microfoontoegang vereisen. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- CoreMediaIO laadt Apple's schermcapture-plugin; ad-hoc ondertekende app heeft dit nodig. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
