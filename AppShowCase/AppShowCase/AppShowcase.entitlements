<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Sandbox expliciet uitgeschakeld voor directe USB-toegang (distributie buiten App Store) -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<!-- Camera entitlement is VERPLICHT voor CMIO/DAL plugin toegang tot USB-apparaten -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.usb</key>
	<true/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<!-- Network client entitlement for local TCP socket to scrcpy server -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
